  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single navy action per view.",
      "html": "<button class=\"ds-btn ds-btn--primary\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Create quotation</button>",
      "css": ".ds-icon{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--t1m-space-2);height:var(--t1m-control-h);padding:0 var(--t1m-space-4);border:1px solid transparent;border-radius:var(--t1m-radius-sm);font:var(--t1m-w-control) var(--t1m-text-base)/1 var(--t1m-font-chrome);cursor:pointer;white-space:nowrap;transition:background var(--t1m-dur-fast) var(--t1m-ease),border-color var(--t1m-dur-fast) var(--t1m-ease)}.ds-btn--primary{background:var(--t1m-navy-700);color:var(--t1m-ink-inverse)}.ds-btn--primary:hover{background:var(--t1m-navy-600)}.ds-btn--primary:active{background:var(--t1m-navy-800)}.ds-btn--primary:focus-visible{outline:none;box-shadow:var(--t1m-focus-ring)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Tonal secondary action: soft navy fill, no outline.",
      "html": "<button class=\"ds-btn ds-btn--secondary\">Save draft</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--t1m-space-2);height:var(--t1m-control-h);padding:0 var(--t1m-space-4);border:1px solid transparent;border-radius:var(--t1m-radius-sm);font:var(--t1m-w-control) var(--t1m-text-base)/1 var(--t1m-font-chrome);cursor:pointer;white-space:nowrap;transition:background var(--t1m-dur-fast) var(--t1m-ease),border-color var(--t1m-dur-fast) var(--t1m-ease)}.ds-btn--secondary{background:var(--t1m-navy-50);color:var(--t1m-navy-700);border-color:var(--t1m-border-strong)}.ds-btn--secondary:hover{background:var(--t1m-navy-50);border-color:var(--t1m-navy-700)}.ds-btn--secondary:focus-visible{outline:none;box-shadow:var(--t1m-focus-ring)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Field with a soft navy focus halo; error swaps to a red halo.",
      "html": "<div class=\"ds-field\"><label for=\"c\">Customer</label><input id=\"c\" class=\"ds-input\" placeholder=\"Search customers\"><span class=\"ds-field__hint\">Type at least 3 characters.</span></div>",
      "css": ".ds-field{display:grid;gap:6px;width:240px}.ds-field label{font-family:var(--t1m-font-chrome);font-size:var(--t1m-text-sm);font-weight:var(--t1m-w-control);color:var(--t1m-ink)}.ds-input{width:100%;height:var(--t1m-control-h);padding:0 var(--t1m-space-3);background:var(--t1m-surface);color:var(--t1m-ink);border:1px solid var(--t1m-border-strong);border-radius:var(--t1m-radius-sm);font:400 var(--t1m-text-base) var(--t1m-font-body);box-shadow:var(--t1m-field-shadow);transition:border-color var(--t1m-dur-fast) var(--t1m-ease),box-shadow var(--t1m-dur-base) var(--t1m-ease)}.ds-input::placeholder{color:var(--t1m-ink-3)}.ds-input:hover{border-color:var(--t1m-ink-3)}.ds-input:focus{outline:none;border-color:var(--t1m-navy-700);box-shadow:var(--t1m-field-focus)}.ds-field__hint{font-size:var(--t1m-text-xs);color:var(--t1m-ink-2)}"
    },
    {
      "name": "Status Pill",
      "kind": "chip",
      "refersTo": "",
      "description": "22px pill: color, icon, and word together.",
      "html": "<span style=\"display:inline-flex;gap:8px;flex-wrap:wrap\"><span class=\"ds-pill ds-pill--info\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 7.5V12l3 2\"/></svg>In progress</span><span class=\"ds-pill ds-pill--success\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Delivered</span><span class=\"ds-pill ds-pill--warning\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4 3 19.5h18z\"/><path d=\"M12 10v4.5M12 17.5v.01\"/></svg>Missing</span><span class=\"ds-pill ds-pill--danger\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4 3 19.5h18z\"/><path d=\"M12 10v4.5M12 17.5v.01\"/></svg>Overdue</span></span>",
      "css": ".ds-icon{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-pill{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 var(--t1m-space-2);border-radius:var(--t1m-radius-sm);font:var(--t1m-w-label) var(--t1m-text-xs)/1 var(--t1m-font-chrome);white-space:nowrap;background:var(--t1m-surface-muted);color:var(--t1m-ink-2)}.ds-pill .ds-icon{width:12px;height:12px;stroke-width:2.25}.ds-pill--info{background:var(--t1m-info-bg);color:var(--t1m-info)}.ds-pill--success{background:var(--t1m-success-bg);color:var(--t1m-success)}.ds-pill--warning{background:var(--t1m-warning-bg);color:var(--t1m-warning)}.ds-pill--danger{background:var(--t1m-danger-bg);color:var(--t1m-danger)}"
    },
    {
      "name": "Nav Item (current)",
      "kind": "nav",
      "refersTo": "nav-item-current",
      "description": "Sidebar item: light weight at rest, heavier on hover, navy wash when current.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav__item\" href=\"#\" aria-current=\"page\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"4\" width=\"7\" height=\"8\"/><rect x=\"13\" y=\"4\" width=\"7\" height=\"5\"/><rect x=\"13\" y=\"11\" width=\"7\" height=\"9\"/><rect x=\"4\" y=\"14\" width=\"7\" height=\"6\"/></svg><span data-text=\"Dashboard\">Dashboard</span></a><a class=\"ds-nav__item\" href=\"#\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\"><path d=\"m12 3 8 4v10l-8 4-8-4V7z\"/><path d=\"m4 7 8 4 8-4M12 11v10\"/></svg><span data-text=\"Shipment jobs\">Shipment jobs</span></a></nav>",
      "css": ".ds-icon{width:var(--t1m-icon-nav);height:var(--t1m-icon-nav);flex:none;fill:none;stroke:currentColor;stroke-width:var(--t1m-icon-stroke);stroke-linecap:round;stroke-linejoin:round}.ds-nav{display:grid;gap:2px;width:220px}.ds-nav__item{display:flex;align-items:center;gap:var(--t1m-space-3);height:36px;padding:0 var(--t1m-space-3);border-radius:var(--t1m-radius-sm);color:var(--t1m-ink-2);text-decoration:none;font-family:var(--t1m-font-chrome);font-weight:var(--t1m-w-nav);font-size:var(--t1m-text-base);white-space:nowrap;transition:background var(--t1m-dur-base) var(--t1m-ease),color var(--t1m-dur-base) var(--t1m-ease)}.ds-nav__item>span{display:inline-grid;transition:font-weight var(--t1m-dur-base) var(--t1m-ease)}.ds-nav__item>span::after{content:attr(data-text);font-weight:var(--t1m-w-nav-active);height:0;overflow:hidden;visibility:hidden}.ds-nav__item:hover,.ds-nav__item:focus-visible{background:var(--t1m-nav-hover-bg);color:var(--t1m-navy-700)}.ds-nav__item:hover>span,.ds-nav__item:focus-visible>span,.ds-nav__item[aria-current=\"page\"]>span{font-weight:var(--t1m-w-nav-active)}.ds-nav__item:focus-visible{outline:none;box-shadow:var(--t1m-focus-ring)}.ds-nav__item[aria-current=\"page\"]{background:var(--t1m-nav-current-bg);color:var(--t1m-nav-current-ink)}"
    },
    {
      "name": "Table Row",
      "kind": "custom",
      "refersTo": "table-row",
      "description": "Job row: emphasized ID, two-line customer, inset rounded hover, actions on hover.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Job ID</th><th>Customer</th><th>Status</th></tr></thead><tbody><tr data-href=\"#\"><td class=\"ds-cell-primary\">TMW-2026-00412</td><td><span class=\"ds-cell-name\">Sample Trading Co.<span class=\"ds-cell-sub\">Import, sea freight</span></span></td><td><span class=\"ds-pill ds-pill--info\">In transit</span></td></tr></tbody></table>",
      "css": ".ds-table{width:400px;border-collapse:separate;border-spacing:0;font-size:var(--t1m-text-base)}.ds-table th{height:44px;padding:0 var(--t1m-space-4);text-align:left;background:var(--t1m-surface);color:var(--t1m-ink-3);font-family:var(--t1m-font-chrome);font-size:var(--t1m-text-xs);font-weight:var(--t1m-w-label);letter-spacing:.05em;text-transform:uppercase;border-bottom:1px solid var(--t1m-border)}.ds-table td{height:var(--t1m-row-h);padding:0 var(--t1m-space-4);border-bottom:1px solid var(--t1m-border);vertical-align:middle;transition:background var(--t1m-dur-fast) var(--t1m-ease)}.ds-table tbody tr:hover td{background:var(--t1m-navy-50);border-bottom-color:transparent}.ds-table tbody tr:hover td:first-child{border-radius:var(--t1m-radius-sm) 0 0 var(--t1m-radius-sm)}.ds-table tbody tr:hover td:last-child{border-radius:0 var(--t1m-radius-sm) var(--t1m-radius-sm) 0}.ds-cell-primary{color:var(--t1m-navy-700);font-weight:var(--t1m-w-control)}.ds-cell-name{display:grid;line-height:1.3}.ds-cell-sub{font-size:var(--t1m-text-xs);color:var(--t1m-ink-3)}.ds-pill{display:inline-flex;align-items:center;height:28px;padding:0 12px;border-radius:var(--t1m-radius-full);font-size:var(--t1m-text-xs);font-weight:var(--t1m-w-label);background:var(--t1m-info-bg);color:var(--t1m-info)}"
    },
    {
      "name": "Milestone Track",
      "kind": "custom",
      "refersTo": "",
      "description": "Shipment 360 stepper: done, current, overdue, upcoming.",
      "html": "<ol class=\"ds-track\"><li class=\"ds-track__step\" data-state=\"done\">Booked<span class=\"ds-track__date\">02 Mar</span></li><li class=\"ds-track__step\" data-state=\"current\">In transit<span class=\"ds-track__date\">06 Mar</span></li><li class=\"ds-track__step\" data-state=\"overdue\">Customs<span class=\"ds-track__date\">08 Mar</span></li><li class=\"ds-track__step\">Delivered<span class=\"ds-track__date\">14 Mar</span></li></ol>",
      "css": ".ds-track{list-style:none;margin:0;padding:0;display:flex;width:420px;font-family:var(--t1m-font-body)}.ds-track__step{flex:1;min-width:96px;position:relative;padding-top:28px;text-align:center;font-size:var(--t1m-text-xs);color:var(--t1m-ink-2)}.ds-track__step::before{content:\"\";position:absolute;top:9px;left:-50%;right:50%;height:2px;background:var(--t1m-border-strong)}.ds-track__step:first-child::before{display:none}.ds-track__step::after{content:\"\";position:absolute;top:2px;left:calc(50% - 8px);width:16px;height:16px;border-radius:var(--t1m-radius-full);background:var(--t1m-surface);border:2px solid var(--t1m-border-strong);z-index:1}.ds-track__step[data-state=\"done\"]+.ds-track__step::before{background:var(--t1m-navy-700)}.ds-track__step[data-state=\"done\"]::after{background:var(--t1m-navy-700);border-color:var(--t1m-navy-700)}.ds-track__step[data-state=\"current\"]{color:var(--t1m-navy-700);font-weight:var(--t1m-w-label)}.ds-track__step[data-state=\"current\"]::after{border-color:var(--t1m-navy-700);box-shadow:0 0 0 4px var(--t1m-navy-100)}.ds-track__step[data-state=\"overdue\"]{color:var(--t1m-danger);font-weight:var(--t1m-w-label)}.ds-track__step[data-state=\"overdue\"]::after{border-color:var(--t1m-danger);background:var(--t1m-danger-bg)}.ds-track__date{display:block;font-weight:400;color:var(--t1m-ink-2)}"
    },
    {
      "name": "Document Checklist Row",
      "kind": "custom",
      "refersTo": "",
      "description": "52px row: file icon, name and meta, status pill, one row action.",
      "html": "<div class=\"ds-doc\"><span class=\"ds-doc__icon\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 3.5h6.5L18 8v12.5H7z\"/><path d=\"M13.5 3.5V8H18M9.5 13h6M9.5 16.5h6\"/></svg></span><div><div class=\"ds-doc__name\">Bill of lading</div><div class=\"ds-doc__meta\">v2 - rejected: consignee name mismatch</div></div><span class=\"ds-pill ds-pill--danger\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4 3 19.5h18z\"/><path d=\"M12 10v4.5M12 17.5v.01\"/></svg>Rejected</span><button class=\"ds-doc__act\">Replace</button></div>",
      "css": ".ds-icon{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-pill{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 var(--t1m-space-2);border-radius:var(--t1m-radius-sm);font:var(--t1m-w-label) var(--t1m-text-xs)/1 var(--t1m-font-chrome);white-space:nowrap;background:var(--t1m-surface-muted);color:var(--t1m-ink-2)}.ds-pill .ds-icon{width:12px;height:12px;stroke-width:2.25}.ds-pill--info{background:var(--t1m-info-bg);color:var(--t1m-info)}.ds-pill--success{background:var(--t1m-success-bg);color:var(--t1m-success)}.ds-pill--warning{background:var(--t1m-warning-bg);color:var(--t1m-warning)}.ds-pill--danger{background:var(--t1m-danger-bg);color:var(--t1m-danger)}.ds-doc{display:grid;grid-template-columns:32px 1fr auto auto;align-items:center;gap:var(--t1m-space-3);min-height:52px;padding:var(--t1m-space-2) var(--t1m-space-4);background:var(--t1m-surface);border:1px solid var(--t1m-border);border-radius:var(--t1m-radius-md);font-family:var(--t1m-font-body);color:var(--t1m-ink)}.ds-doc__icon{width:32px;height:32px;border-radius:var(--t1m-radius-sm);background:var(--t1m-surface-muted);display:grid;place-items:center;color:var(--t1m-ink-2)}.ds-doc__name{font-weight:var(--t1m-w-control)}.ds-doc__meta{font-size:var(--t1m-text-xs);color:var(--t1m-ink-2)}.ds-doc__act{height:var(--t1m-control-h-sm);padding:0 var(--t1m-space-3);background:transparent;color:var(--t1m-navy-700);border:1px solid transparent;border-radius:var(--t1m-radius-sm);font:var(--t1m-w-control) var(--t1m-text-sm) var(--t1m-font-chrome);cursor:pointer}.ds-doc__act:hover{background:var(--t1m-navy-50)}.ds-doc__act:focus-visible{outline:none;box-shadow:var(--t1m-focus-ring)}"
    },
    {
      "name": "Alert",
      "kind": "custom",
      "refersTo": "",
      "description": "Inline notice: tinted status color, icon, bold title, one sentence.",
      "html": "<div class=\"ds-alert ds-alert--warning\" role=\"alert\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 4 3 19.5h18z\"/><path d=\"M12 10v4.5M12 17.5v.01\"/></svg><div><strong>Commercial invoice missing</strong>Upload it before 10 Mar to keep customs on schedule.</div></div>",
      "css": ".ds-icon{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}.ds-alert{display:flex;gap:var(--t1m-space-3);padding:var(--t1m-space-3) var(--t1m-space-4);border-radius:var(--t1m-radius-md);font:400 var(--t1m-text-base) var(--t1m-font-body);border:1px solid}.ds-alert .ds-icon{margin-top:2px}.ds-alert--warning{background:var(--t1m-warning-bg);color:var(--t1m-warning);border-color:color-mix(in srgb,var(--t1m-warning) 25%,transparent)}.ds-alert strong{display:block;color:var(--t1m-ink)}"
    },
    {
      "name": "Dropdown",
      "kind": "custom",
      "refersTo": "input",
      "description": "Field-styled trigger with a floating listbox: check on selected, soft highlight, optional descriptions.",
      "html": "<div class=\"ds-dd\"><button class=\"ds-trigger\" type=\"button\">Import, sea freight<svg class=\"ds-chev\" viewBox=\"0 0 24 24\"><path d=\"m6 9 6 6 6-6\"/></svg></button><ul class=\"ds-menu\"><li class=\"ds-option is-active\"><span>Import, sea freight<small>Origin port to Manila</small></span></li><li class=\"ds-option is-selected\"><span>Export, sea freight<small>Manila to destination</small></span><svg viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg></li><li class=\"ds-option\"><span>Air freight</span></li></ul></div>",
      "css": ".ds-dd{position:relative;width:280px;padding-bottom:150px}.ds-trigger{display:flex;align-items:center;justify-content:space-between;width:100%;height:var(--t1m-control-h);padding:0 var(--t1m-space-3);background:var(--t1m-surface);color:var(--t1m-ink);border:1px solid var(--t1m-navy-700);border-radius:var(--t1m-radius-sm);box-shadow:var(--t1m-field-focus);font:400 var(--t1m-text-base) var(--t1m-font-body);text-align:left}.ds-chev{width:16px;height:16px;fill:none;stroke:var(--t1m-navy-700);stroke-width:var(--t1m-icon-stroke);stroke-linecap:round;stroke-linejoin:round;rotate:180deg}.ds-menu{position:absolute;top:calc(36px + 6px);left:0;right:0;margin:0;padding:4px;list-style:none;background:var(--t1m-surface);border:1px solid var(--t1m-border);border-radius:var(--t1m-radius-md);box-shadow:var(--t1m-shadow-float)}.ds-option{display:flex;align-items:center;justify-content:space-between;min-height:36px;padding:6px 10px 6px 12px;border-radius:calc(var(--t1m-radius-md) - 4px);color:var(--t1m-ink);cursor:pointer}.ds-option small{display:block;font-size:var(--t1m-text-xs);color:var(--t1m-ink-3)}.ds-option:hover,.ds-option.is-active{background:var(--t1m-navy-50)}.ds-option.is-selected{color:var(--t1m-navy-700);font-weight:var(--t1m-w-control)}.ds-option svg{width:16px;height:16px;fill:none;stroke:var(--t1m-navy-700);stroke-width:var(--t1m-icon-stroke);stroke-linecap:round;stroke-linejoin:round}"
    }
  ],
  "narrative": {
    "northStar": "The Dispatch Desk",
    "overview": "A dispatcher's desk at 9 a.m.: everything in reach, nothing decorative, the urgent item visible without hunting. The portal borrows Top1Movers' identity (their navy and their red mark) and puts it to work in a dense, calm, table-first interface that people read for hours.\n\nSurfaces are flat and outlined. Structure comes from borders, tint, and consistent row rhythm, not shadow. Navy carries action; status colors carry meaning and are always backed by an icon and a word. Type is light and weight follows attention: chrome rests at regular-to-light weights and grows heavier only when it is hovered, current, or urgent. The look is deliberately quiet so overdue tasks, missing documents, and exceptions are the loudest things on any screen.",
    "keyCharacteristics": [
      "Job-centric: the Shipment 360 view is the hub; every module links back to a job.",
      "Two densities from one component set: 36px desktop, 44px touch.",
      "Quiet chrome: a white, bordered sidebar with light-weight labels; navy is spent on primary buttons, links, and headings.",
      "Softened color: brand navy and red are lifted and eased in the UI; the exact brand colors live in the logo. Body text is 13.6:1, never harsher.",
      "Light theme only in Phase 1 (daytime offices, lit warehouse floors).",
      "Brand red is an identity mark, not a control color."
    ],
    "rules": [
      {
        "name": "The Navy Works, Red Signs Rule",
        "body": "Actions are navy. Red #E5383B only ever marks identity or current location. Trouble is Danger #B3372D, always with an icon.",
        "section": "colors"
      },
      {
        "name": "The Never Color Alone Rule",
        "body": "A status is a color, an icon, and a word together.",
        "section": "colors"
      },
      {
        "name": "The Weight Follows Attention Rule",
        "body": "Chrome rests light (nav and tabs 400, controls 500). Weight rises to 600 for hover, focus, and current states, and never as a default. Bold is a signal, so nothing is bold at rest.",
        "section": "typography"
      },
      {
        "name": "The Tokens Own The Font Rule",
        "body": "Font families are declared once as `--t1m-font-*` in tokens.css. Components never name a font. The source (bundled file, Google Fonts, CDN) can change there without touching components.",
        "section": "typography"
      },
      {
        "name": "The Flat-Until-Floating Rule",
        "body": "If it doesn't overlay other content, it has no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use only `var(--t1m-*)` tokens for color, size, space, radius, and font.",
      "**Do** pair every status color with an icon and a word.",
      "**Do** keep one navy primary button per view and name the action (\"Create quotation\").",
      "**Do** build empty, loading, error, disabled, and focus states for every component.",
      "**Do** surface overdue tasks, missing documents, and exceptions in list rows and on Shipment 360.",
      "**Do** label all mock data as illustrative (IDs like TMW-2026-00412, \"Sample Trading Co.\")."
    ],
    "donts": [
      "**Don't** fill a button, badge, banner, or nav item with Signal Red #E5383B, or use it as a side stripe.",
      "**Don't** hardcode hex values, px font sizes, or font names in components.",
      "**Don't** nest panels or put every group in a card; don't use colored side stripes on cards or rows.",
      "**Don't** use emoji or text glyphs as icons; add to `icons.svg` in the same 1.75-stroke style.",
      "**Don't** use gradient text, glassmorphism, or decorative shadows.",
      "**Don't** open a modal for what a drawer, inline edit, or page can do.",
      "**Don't** invent components: check `index.html` first, and if it's missing, add it to the system (tokens.css, components.css, index.html, this file) before using it."
    ]
  }
}